ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex            # free tier = iex; "sip" only if you pay
FINNHUB_API_KEY=                # optional; fundamentals/earnings
LLM_PROVIDER=gemini             # gemini | ollama
GEMINI_API_KEY=                 # free key from Google AI Studio (aistudio.google.com)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite   # ordered fallback, best first (check Google's current free-tier list)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=                   # e.g. a ~7-8B instruct model with tool calling
ALLOW_PROVIDER_TRAINING_ON_DATA=true   # Gemini free tier may use prompts to improve Google products
DATA_ENCRYPTION_KEY=            # openssl rand -base64 32  (encrypts your financial data at rest)
SLIPPAGE_BPS=5                  # per side, used for "realistic P&L"
COMMISSION_PER_TRADE=0
QUOTE_POLL_MS=3000              # live price refresh interval
DATABASE_URL=postgres://paper:paper@localhost:5433/paper_terminal   # local docker db; Neon pooled URL in prod
AUTH_SECRET=                    # openssl rand -base64 33
AUTH_GITHUB_ID=                 # GitHub OAuth app client ID
AUTH_GITHUB_SECRET=             # GitHub OAuth app client secret
ALLOWED_GITHUB_USER=            # your GitHub username; nobody else can log in
CRON_SECRET=                    # openssl rand -hex 32
DEMO_MODE=false
